# Copier ce fichier en .env.local (développement) ou .env.production (mise en ligne) et renseigner :
# Supabase → Project Settings → API (ou Connect) : l'adresse du projet et la clé PUBLIQUE
# (« publishable » sb_publishable_… ou « anon »). Jamais la clé « secret » / « service_role ».
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
